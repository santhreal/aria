package aria:plugin@1.0.0;

/// WebAssembly component world for Aria plugins (API major 1).
world plugin {
    /// Severity level for plugin log messages.
    enum log-level {
        /// Step-by-step detail.
        trace,
        /// Diagnostic detail.
        debug,
        /// Normal operation.
        info,
        /// A problem the plugin recovered from.
        warn,
        /// A failure.
        error,
    }

    /// Timeline importer registration metadata.
    record importer-spec {
        /// Not empty, and unique among importers and exporters.
        id: string,
        /// The format as a menu lists it, such as `CMX 3600 EDL`.
        name: string,
        /// The file extensions it reads, without the dot: at least one, each ASCII letters and
        /// digits. Matched without regard to case.
        extensions: list<string>,
    }

    /// Timeline exporter registration metadata.
    record exporter-spec {
        /// Not empty, and unique among importers and exporters.
        id: string,
        /// The format as a menu lists it.
        name: string,
        /// The extension of the file it writes, without the dot: ASCII letters and digits,
        /// stored lowercase.
        extension: string,
    }

    /// Media encoder registration metadata.
    record encoder-spec {
        /// Not empty, and unique among encoders.
        id: string,
        /// The format as the Export dialog lists it, such as `Apple ProRes 422`.
        name: string,
        /// The extension of the file it writes, without the dot: ASCII letters and digits,
        /// stored lowercase. Selecting the encoder sets the destination's extension.
        extension: string,
        /// The encoder takes audio through `encoder-push-audio`. When false, the Export dialog
        /// hides the Audio row and the export is video only.
        audio: bool,
    }

    /// Configuration passed to `encoder-open`.
    record encoder-config {
        /// Frame width in pixels.
        width: u32,
        /// Frame height in pixels.
        height: u32,
        /// Frame rate numerator: `fps-num / fps-den` frames per second.
        fps-num: s64,
        /// Frame rate denominator.
        fps-den: s32,
        /// Requested video bitrate in kilobits per second, or 0 when the export requests none.
        video-bitrate-kbps: u32,
        /// Requested audio bitrate in kilobits per second. The host passes 0.
        audio-bitrate-kbps: u32,
    }

    /// One RGBA video frame passed to `encoder-push-frame`.
    record encoder-frame {
        /// Straight-alpha RGBA8 pixels: `height` rows of `stride` bytes, top row first.
        rgba: list<u8>,
        /// Frame width in pixels.
        width: u32,
        /// Frame height in pixels.
        height: u32,
        /// Bytes per row, at least `width * 4`.
        stride: u32,
        /// Presentation time in ticks of `pts-rate`: the frame starts `pts-value / pts-rate`
        /// seconds into the file.
        pts-value: s64,
        /// Ticks per second of `pts-value`.
        pts-rate: s32,
    }

    /// One interleaved `f32` audio block passed to `encoder-push-audio`.
    record encoder-audio {
        /// Interleaved samples, `channels` per sample frame.
        samples: list<f32>,
        /// Sample frames per second.
        sample-rate: u32,
        /// Channels per sample frame.
        channels: u32,
        /// Presentation time of the first sample frame in ticks of `pts-rate`.
        pts-value: s64,
        /// Ticks per second of `pts-value`.
        pts-rate: s32,
    }

    /// Result returned from a timeline import operation.
    record import-result {
        /// Serde JSON of `Vec<aria_commands::Command>`, applied as one transaction.
        commands-json: string,
        /// Source items skipped by the importer.
        skipped: list<string>,
    }

    /// Report returned from a timeline export operation.
    record report {
        /// Project items that the target format could not represent.
        skipped: list<string>,
    }

    /// Scalar parameter definition for an audio effect.
    record audio-param-spec {
        /// Parameter key, unique within the effect.
        name: string,
        /// The parameter's row label.
        label: string,
        /// Value of a new insert, inside `min..=max`.
        default-value: f32,
        /// Lowest value.
        min: f32,
        /// Highest value, not below `min`.
        max: f32,
    }

    /// Audio effect registration metadata.
    record audio-effect-spec {
        /// Namespaced id with at least one `.`, such as `com.example.drive`. A shipped id or an
        /// id already registered is refused.
        id: string,
        /// The name the Effect menu and the mixer inserts list. Not empty.
        label: string,
        /// Scalar parameters in slot order. `audio-process` receives their signals in this
        /// order.
        params: list<audio-param-spec>,
        /// Frames at 48 kHz by which the output trails the input, at most 48000. The mixer
        /// delays every parallel path by the same amount.
        latency: u32,
        /// The effect reads a key signal: a mixer strip shows a Key from row, and `audio-block`
        /// carries the key lane.
        sidechain: bool,
    }

    /// Handle to a session the plugin holds: an audio processor, an encoder, a decoder stream,
    /// or an analyzer.
    type instance = u64;

    /// Parameter signal for one parameter across an audio block.
    record audio-param {
        /// The value for the whole block, or the first frame's value when `per-frame` is set.
        constant: f32,
        /// One value per frame when the parameter is keyframed and changes within the block;
        /// empty otherwise.
        per-frame: list<f32>,
    }

    /// Planar stereo audio block passed to `audio-process`.
    record audio-block {
        /// Left channel samples. The block holds as many frames as this list.
        left: list<f32>,
        /// Right channel samples, as many as `left`.
        right: list<f32>,
        /// Sequence position of the first frame, in frames at `sample-rate`.
        position: s64,
        /// Frames per second.
        sample-rate: u32,
        /// Left channel of the key signal, or empty when the effect takes no key or the insert
        /// has no key lane.
        sidechain-left: list<f32>,
        /// Right channel of the key signal, or empty as `sidechain-left` is.
        sidechain-right: list<f32>,
    }

    /// Processed planar stereo output buffers returned from `audio-process`.
    record stereo-buffers {
        /// Processed left channel. The host copies at most the block's frame count; frames past
        /// a shorter list keep their input.
        left: list<f32>,
        /// Processed right channel, copied as `left` is.
        right: list<f32>,
    }

    /// Docked location for a declared plugin panel.
    enum panel-location {
        /// The left frame.
        sidebar,
        /// The right frame.
        inspector,
        /// The bottom frame.
        timeline,
    }

    /// Registration metadata for a docked plugin panel.
    record panel-spec {
        /// Not empty, and unique among panels.
        id: string,
        /// The dock tab title and the Window menu row. Not empty.
        title: string,
        /// The frame the panel opens in.
        location: panel-location,
    }

    /// Text color tone for `ui-node::text`.
    enum tone {
        /// The body text color.
        normal,
        /// The secondary text color.
        muted,
        /// The theme's success color.
        success,
        /// The theme's warning color.
        warning,
        /// The theme's danger color.
        danger,
    }

    /// Paragraph text node with tone.
    record ui-text {
        /// The paragraph.
        text: string,
        /// Its color.
        tone: tone,
    }

    /// Key-value field row.
    record ui-field {
        /// The label on the left.
        label: string,
        /// The value on the right.
        value: string,
    }

    /// Push button control.
    record ui-button {
        /// Control id: unique in the tree, 1 to 128 bytes, no control characters.
        id: string,
        /// The button text.
        label: string,
        /// Drawn disabled. A press sends no event.
        disabled: bool,
    }

    /// Boolean toggle control.
    record ui-toggle {
        /// Control id: unique in the tree, 1 to 128 bytes, no control characters.
        id: string,
        /// The switch label.
        label: string,
        /// The current state. A click sends `panel-event::toggled` with the opposite.
        on: bool,
    }

    /// Numeric slider control.
    record ui-slider {
        /// Control id: unique in the tree, 1 to 128 bytes, no control characters.
        id: string,
        /// The slider label.
        label: string,
        /// The current value, inside `min..=max`.
        value: f64,
        /// The lowest value: finite and below `max`.
        min: f64,
        /// The highest value: finite.
        max: f64,
        /// The snap step, in `0..=max - min`. 0 clamps without snapping.
        step: f64,
    }

    /// Single-line text input control.
    record ui-input {
        /// Control id: unique in the tree, 1 to 128 bytes, no control characters.
        id: string,
        /// The current text.
        value: string,
        /// The text shown while the box is empty.
        placeholder: string,
    }

    /// Multi-option chip selector control.
    record ui-choice {
        /// Control id: unique in the tree, 1 to 128 bytes, no control characters.
        id: string,
        /// The selector label.
        label: string,
        /// The chip labels: 1 to 64.
        options: list<string>,
        /// Index of the selected option, below the option count.
        selected: u32,
    }

    /// Progress bar indicator.
    record ui-progress {
        /// The bar label.
        label: string,
        /// The filled fraction, 0.0 to 1.0.
        fraction: f32,
    }

    /// Straight-alpha RGBA8 image node (`width * height * 4` bytes).
    record ui-image {
        /// Width in pixels, 1 to 2048.
        width: u32,
        /// Height in pixels, 1 to 2048.
        height: u32,
        /// `width * height * 4` bytes of straight-alpha RGBA8.
        rgba: list<u8>,
    }

    /// One node in a flattened panel tree (`root = index 0`).
    /// Container nodes (`column`, `row`) hold indices into the flat `list<ui-node>`.
    variant ui-node {
        /// Children drawn top to bottom, as indices into the flat list.
        column(list<u32>),
        /// Children drawn left to right, wrapping, as indices into the flat list.
        row(list<u32>),
        /// A title line.
        heading(string),
        /// A paragraph in a tone.
        text(ui-text),
        /// A label and value row.
        field(ui-field),
        /// A rule between rows.
        separator,
        /// A push button.
        button(ui-button),
        /// A switch.
        toggle(ui-toggle),
        /// A track and value.
        slider(ui-slider),
        /// A one-line text box.
        input(ui-input),
        /// A row of chips.
        choice(ui-choice),
        /// A bar filled to its fraction.
        progress(ui-progress),
        /// An image, narrowed to fit the panel.
        image(ui-image),
    }

    /// Payload for `panel-event::toggled`.
    record panel-toggled {
        /// The toggle's id.
        id: string,
        /// The new state.
        on: bool,
    }

    /// Payload for `panel-event::slid`.
    record panel-slid {
        /// The slider's id.
        id: string,
        /// The value on release, clamped to the range and snapped to the step.
        value: f64,
    }

    /// Payload for `panel-event::submitted`.
    record panel-submitted {
        /// The input's id.
        id: string,
        /// The text when Enter was pressed, at most 16 KiB.
        text: string,
    }

    /// Payload for `panel-event::chose`.
    record panel-chose {
        /// The selector's id.
        id: string,
        /// Index of the chosen option.
        index: u32,
    }

    /// Interaction event delivered from a panel control to the plugin.
    variant panel-event {
        /// A button was pressed. The payload is its id.
        pressed(string),
        /// A toggle was clicked.
        toggled(panel-toggled),
        /// A slider was released.
        slid(panel-slid),
        /// Enter was pressed in an input. Escape sends nothing.
        submitted(panel-submitted),
        /// A chip was clicked.
        chose(panel-chose),
    }

    /// 2D coordinate or size in sequence frame pixels.
    record point {
        /// Horizontal coordinate or width, rightward.
        x: f32,
        /// Vertical coordinate or height, downward.
        y: f32,
    }

    /// Stroke or fill color for a viewer overlay shape.
    variant overlay-color {
        /// The theme accent color.
        accent,
        /// The theme text color.
        text,
        /// The theme muted color.
        muted,
        /// The theme success color.
        success,
        /// The theme warning color.
        warning,
        /// The theme danger color.
        danger,
        /// Straight-alpha sRGB bytes `(r, g, b, a)`.
        rgba(tuple<u8, u8, u8, u8>),
    }

    /// Visual glyph drawn for a draggable viewer overlay handle.
    enum handle-look {
        /// A dot.
        dot,
        /// A square.
        square,
        /// A cross.
        cross,
    }

    /// Straight line segment in a viewer overlay scene.
    record overlay-line {
        /// Start point in canvas pixels.
        %from: point,
        /// End point in canvas pixels.
        to: point,
        /// Stroke color.
        color: overlay-color,
        /// Stroke width in window pixels, above 0 and at most 32.
        width: f32,
    }

    /// Axis-aligned rectangle in a viewer overlay scene.
    record overlay-rect {
        /// Top-left corner in canvas pixels.
        origin: point,
        /// Width and height in canvas pixels, not negative.
        size: point,
        /// Outline color.
        color: overlay-color,
        /// Stroke width in window pixels, above 0 and at most 32.
        width: f32,
        /// Fill color, or none for an outline only.
        fill: option<overlay-color>,
    }

    /// Axis-aligned ellipse in a viewer overlay scene.
    record overlay-ellipse {
        /// Center in canvas pixels.
        center: point,
        /// Horizontal and vertical radius in canvas pixels, not negative.
        radii: point,
        /// Outline color.
        color: overlay-color,
        /// Stroke width in window pixels, above 0 and at most 32.
        width: f32,
        /// Fill color, or none for an outline only.
        fill: option<overlay-color>,
    }

    /// Polyline or closed polygon in a viewer overlay scene.
    record overlay-path {
        /// At least two points in canvas pixels.
        points: list<point>,
        /// Joins the last point back to the first.
        closed: bool,
        /// Stroke color.
        color: overlay-color,
        /// Stroke width in window pixels, above 0 and at most 32.
        width: f32,
    }

    /// Text label in a viewer overlay scene.
    record overlay-text {
        /// Top-left corner of the line in canvas pixels.
        at: point,
        /// One line of text, with no line break.
        text: string,
        /// Text color.
        color: overlay-color,
        /// Text size in window pixels, 6 to 96.
        size: f32,
    }

    /// Draggable handle in a viewer overlay scene.
    record overlay-handle {
        /// Handle id: unique among the scene's handles, 1 to 128 bytes, no control characters.
        id: string,
        /// Center in canvas pixels.
        at: point,
        /// Handle color.
        color: overlay-color,
        /// The glyph, 12 pixels across.
        look: handle-look,
    }

    /// One vector primitive or handle in a viewer overlay scene.
    variant overlay-shape {
        /// A straight stroke.
        line(overlay-line),
        /// An axis-aligned rectangle.
        rect(overlay-rect),
        /// An axis-aligned ellipse.
        ellipse(overlay-ellipse),
        /// Straight segments through its points.
        path(overlay-path),
        /// One line of text, drawn above every stroke.
        text(overlay-text),
        /// A draggable handle, drawn above every stroke.
        handle(overlay-handle),
    }

    /// Phase of a pointer drag on an `overlay-handle`.
    enum drag-phase {
        /// The press on the handle.
        start,
        /// A pointer step with the button held.
        move,
        /// The release, wherever the pointer is.
        end,
    }

    /// Payload for `overlay-event::drag`.
    record overlay-drag {
        /// Id of the pressed handle.
        handle: string,
        /// The step of the drag.
        phase: drag-phase,
        /// The pointer in canvas pixels. It may lie off the frame.
        at: point,
    }

    /// Interaction event delivered from a viewer overlay handle to the plugin.
    variant overlay-event {
        /// A pointer drag on a handle.
        drag(overlay-drag),
    }

    /// Viewer overlay registration metadata.
    record overlay-spec {
        /// Not empty, and unique among viewer overlays.
        id: string,
        /// The overlay's name, shown before an error its handler returns. Not empty.
        title: string,
    }

    /// One step of a background job, returned by `job-step`.
    record job-step {
        /// Fraction done, 0.0 to 1.0, or none while it is unknown.
        progress: option<f32>,
        /// The line the jobs board shows.
        detail: string,
        /// The job is finished, and `detail` is its last line.
        done: bool,
        /// The next step cannot be undone: Cancel is refused from here on.
        commit: bool,
    }

    /// The trust an AI tool needs before the assistant runs it.
    enum ai-tool-tier {
        /// Reads state and changes nothing. Runs without asking.
        read-only,
        /// Changes the project or the editor in a way an undo reverses.
        workspace,
        /// Deletes data, writes outside the project, or reaches another
        /// system. Runs once the call is allowed, unless Settings > AI > Autonomy is Full.
        system,
    }

    /// An AI tool the assistant lists.
    record ai-tool-spec {
        /// 1 to 56 bytes of lowercase ASCII letters, digits, and `_`. The
        /// assistant calls the tool `plugin_<name>`.
        name: string,
        /// What the tool does, for the model.
        description: string,
        /// A JSON Schema object describing the arguments, as JSON text.
        parameters-json: string,
        /// The trust the tool needs.
        tier: ai-tool-tier,
    }

    /// A PNG image an AI tool returns, at most 2048 pixels on a side.
    record ai-tool-image {
        /// A caption of a few words.
        label: string,
        /// The PNG file bytes.
        png: list<u8>,
    }

    /// What an AI tool returns to the model.
    record ai-tool-output {
        /// The text the model reads.
        text: string,
        /// The images the model receives.
        images: list<ai-tool-image>,
    }

    /// A scope the scope strip shows.
    record scope-spec {
        /// ASCII letters, digits, `.`, `-` and `_`, unique among every
        /// plugin's scopes.
        id: string,
        /// The caption above the image.
        name: string,
        /// Width of the image the scope draws, 1 to 512.
        width: u32,
        /// Height of the image the scope draws, 1 to 512.
        height: u32,
    }

    /// The frame a scope reads: `width * height` RGBA8 pixels, sRGB, straight
    /// alpha, top row first.
    record scope-frame {
        /// Frame width in pixels.
        width: u32,
        /// Frame height in pixels.
        height: u32,
        /// `width * height * 4` bytes.
        pixels: list<u8>,
    }

    /// What a scope draws: RGBA8 pixels at the size its spec declares, or an
    /// empty list for a transparent image, and one readout line of at most
    /// 160 bytes.
    record scope-drawing {
        /// RGBA8 pixels at the size the spec declares, or empty for a transparent image.
        pixels: list<u8>,
        /// The readout line, at most 160 bytes.
        readout: string,
    }

    /// Media decoder registration metadata.
    record decoder-spec {
        /// Not empty, and unique among the plugin's decoders.
        id: string,
        /// The format name, such as `YUV4MPEG2`.
        name: string,
        /// File extensions without the dot: ASCII letters and digits.
        extensions: list<string>,
        /// Among decoders claiming one extension, a higher priority is tried first.
        priority: s32,
    }

    /// What `decoder-probe` reports about a file.
    record media-probe {
        /// Frame width in pixels.
        width: u32,
        /// Frame height in pixels.
        height: u32,
        /// Frame rate numerator: `frame-rate-num / frame-rate-den` frames per second.
        frame-rate-num: s32,
        /// Frame rate denominator.
        frame-rate-den: s32,
        /// Length in whole frames at the frame rate, 0 when unknown.
        frame-count: s64,
        /// The file has a sound track.
        has-audio: bool,
        /// The file is a still image: one frame, no time base.
        is-image: bool,
        /// The video codec name, or none when unknown.
        video-codec: option<string>,
        /// The audio codec name, or none when unknown.
        audio-codec: option<string>,
    }

    /// Pixel layout of decoded frames.
    enum frame-format {
        /// A full-size Y plane, then interleaved U and V at half width and half height.
        nv12,
        /// Y, U, and V planes; U and V at half width and half height.
        yuv420p,
    }

    /// Color space of decoded frames.
    enum frame-color {
        /// BT.709, limited range.
        bt709,
        /// BT.601, limited range.
        bt601,
        /// BT.2020 primaries, PQ transfer, limited range.
        bt2020-pq,
        /// sRGB, full range.
        srgb,
    }

    /// What `decoder-open-video` reports about the stream it opened.
    record video-info {
        /// Even, at most 16384.
        width: u32,
        /// Even, at most 16384.
        height: u32,
        /// Pixel layout of every frame.
        format: frame-format,
        /// Color space of every frame.
        color: frame-color,
        /// Frame rate numerator: `frame-rate-num / frame-rate-den` frames per second.
        frame-rate-num: s32,
        /// Frame rate denominator.
        frame-rate-den: s32,
        /// Every pts counts ticks at `time-base-num / time-base-den` ticks per second.
        time-base-num: s32,
        /// Time base denominator.
        time-base-den: s32,
        /// Length in time-base ticks, when known.
        duration: option<s64>,
    }

    /// A video stream `decoder-open-video` opened.
    record opened-video {
        /// The stream handle `decoder-seek`, `decoder-next-frame`, and `decoder-close` receive.
        instance: instance,
        /// What the stream holds.
        info: video-info,
    }

    /// One decoded frame: its pts and its planes in plane order, each row
    /// packed at the plane's row width with no padding.
    record decoded-frame {
        /// Presentation time in time-base ticks.
        pts: s64,
        /// The planes, rows packed with no padding: Y is `width` bytes by `height` rows, the
        /// NV12 UV plane is `width` bytes by `height / 2` rows, and each YUV 4:2:0 chroma plane
        /// is `width / 2` bytes by `height / 2` rows.
        planes: list<list<u8>>,
    }

    /// Why a decoder open or probe failed.
    variant decode-error {
        /// The decoder does not read this file; the host tries the next decoder.
        unsupported(string),
        /// The decoder reads this file and failed.
        failed(string),
    }

    /// Value kind of a visual effect or transition parameter.
    enum effect-param-kind {
        /// An `f32` in `min..=max`.
        scalar,
        /// An integer in `min..=max`, each bound rounded.
        int,
        /// A switch.
        boolean,
        /// One option of `choices`.
        choice,
        /// An RGBA color; the shader reads linear RGBA in `0..1`.
        color,
        /// Two components in `min..=max`. A clip type's `handles` draws it on the Viewer.
        vec2,
        /// Three components in `min..=max`.
        point3,
        /// Width and height in `min..=max`.
        size,
        /// Degrees in `min..=max`.
        angle,
        /// A response curve over `0..1`, read by a shader as 64 samples.
        curve,
        /// A color gradient over `0..1`, read by a shader as 64 linear RGBA samples.
        gradient,
        /// UTF-8 text. Shaders do not read it.
        text,
        /// A font family name. Shaders do not read it.
        font,
        /// A file path. Shaders do not read it.
        file,
        /// A clip on the timeline. A pass that lists it as an input reads that clip's frame.
        layer,
    }

    /// Inspector control presentation for a scalar parameter.
    enum effect-param-display {
        /// A horizontal scrub slider.
        slider,
        /// A rotary dial in degrees.
        angle-dial,
        /// The value formatted as a percentage.
        percentage,
    }

    /// One option of an `effect-param-kind::choice` parameter.
    record effect-choice-option {
        /// Option id, stored on the effect instance.
        id: string,
        /// The text the dropdown lists.
        label: string,
    }

    /// One control point on an `effect-param-kind::curve` parameter (`x, y` in `0.0..=1.0`).
    record effect-curve-point {
        /// Input, in `0.0..=1.0`.
        x: f32,
        /// Output at `x`.
        y: f32,
    }

    /// One color stop on an `effect-param-kind::gradient` parameter.
    record effect-gradient-stop {
        /// Position along the gradient, in `0.0..=1.0`.
        position: f32,
        /// Linear RGBA `(r, g, b, a)`.
        color: tuple<f32, f32, f32, f32>,
    }

    /// Condition under which a parameter row is shown in the inspector.
    record effect-visibility-condition {
        /// Name of the controlling parameter of the same effect or transition.
        param: string,
        /// Shows the row while the controlling switch equals this.
        equals-bool: option<bool>,
        /// Shows the row while the controlling integer equals this.
        equals-int: option<s32>,
        /// Shows the row while the controlling choice selects this option id. The host reads
        /// `equals-choice`, then `equals-bool`, then `equals-int`, and uses the first that is
        /// set.
        equals-choice: option<string>,
    }

    /// Named collapsible parameter group in an effect or transition inspector.
    record effect-group-spec {
        /// Group id that parameters name in `group`.
        id: string,
        /// The section heading in Effect Controls.
        label: string,
        /// The section starts collapsed.
        collapsed: bool,
    }

    /// Parameter definition for a visual effect, generator, or transition.
    record effect-param-spec {
        /// Parameter key: unique within the effect and a WGSL identifier. A shader reads it
        /// through `param_<name>()`.
        name: string,
        /// The row label.
        label: string,
        /// The value kind.
        kind: effect-param-kind,
        /// Default for `scalar` and `angle`.
        default-value: f32,
        /// Lowest value of `scalar`, `vec2`, `point3`, `size`, and `angle`. Rounded, the lowest
        /// `int`.
        min: f32,
        /// Highest value, as `min` is the lowest. Not below `min`.
        max: f32,
        /// Default for `color`: RGBA `(r, g, b, a)` in `0..=255`.
        default-color: tuple<u8, u8, u8, u8>,
        /// Default for `vec2` and `size`.
        default-vec2: tuple<f32, f32>,
        /// The control a `scalar` row draws.
        display: effect-param-display,
        /// Lower end of the scrub range before values clamp to `min`, or none.
        soft-min: option<f32>,
        /// Upper end of the scrub range before values clamp to `max`, or none.
        soft-max: option<f32>,
        /// Unit suffix, such as `px`, `deg`, `%`, or `s`, or none.
        unit: option<string>,
        /// Tooltip text for the row, or none.
        tooltip: option<string>,
        /// Id of the `effect-group-spec` the row sits in, or none.
        group: option<string>,
        /// Shows the row only while the condition holds, or always when none.
        visible-when: option<effect-visibility-condition>,
        /// The options of a `choice`.
        choices: list<effect-choice-option>,
        /// Default for `int`.
        default-int: s32,
        /// Default for `boolean`.
        default-bool: bool,
        /// Default option id for `choice`. Empty selects the first option.
        default-choice: string,
        /// Default for `point3`.
        default-vec3: tuple<f32, f32, f32>,
        /// Default control points for `curve`. Empty is the identity `(0, 0)` to `(1, 1)`.
        default-curve: list<effect-curve-point>,
        /// Default stops for `gradient`. Empty is black to white.
        default-gradient: list<effect-gradient-stop>,
        /// Default for `text`, `font`, and `file`.
        default-text: string,
    }

    /// Visual effect or generator registration metadata.
    record effect-spec {
        /// Namespaced id with at least one `.`, not already in the catalog.
        id: string,
        /// The name the Effect menu and Effect Controls show. Not empty.
        label: string,
        /// The Effect menu submenu. Empty lists the effect under Other. Generators are not
        /// listed in the Effect menu.
        category: string,
        /// Parameters in row order. Flattened values follow this order.
        params: list<effect-param-spec>,
        /// Collapsible parameter sections, in display order.
        groups: list<effect-group-spec>,
        /// The entry draws a frame without reading an input. `register-effect` sets it false
        /// and `register-generator` true; `register-cpu-effect` and `register-effect-graph`
        /// read it.
        generator: bool,
        /// The output at a time depends on frames before it, as feedback and trails do.
        stateful: bool,
    }

    /// Transition registration metadata.
    record transition-spec {
        /// Namespaced id with at least one `.`, not already in the catalog.
        id: string,
        /// The name the transition list shows. Not empty.
        label: string,
        /// Parameters in row order. A shader reads each through `param_<name>()`.
        params: list<effect-param-spec>,
    }

    /// How an effect graph pass runs.
    variant pass-stage {
        /// `@fragment fn fs`, drawn over the whole output.
        fragment,
        /// `@compute @workgroup_size(x, y, 1) fn cs` dispatched over the
        /// output in tiles of this width and height, writing `output_tex`.
        compute(tuple<u32, u32>),
    }

    /// One texture an effect graph pass reads.
    variant pass-input {
        /// The effect's input frame, bound as `source_tex`.
        source,
        /// The output of the named pass, bound as `pass_<name>`.
        pass(string),
        /// The frame of the clip the named layer parameter references,
        /// bound as `layer_<param>`.
        layer(string),
        /// The plugin texture registered under this id, bound as
        /// `texture_<id>` with every character other than an ASCII letter,
        /// digit, or `_` replaced by `_`.
        texture(string),
    }

    /// The size an effect graph pass writes.
    variant output-size {
        /// The effect's input size.
        same,
        /// The input size times this width and height factor, rounded, at
        /// least one pixel.
        scale(tuple<f32, f32>),
        /// This width and height in pixels.
        fixed(tuple<u32, u32>),
    }

    /// One pass of an effect graph.
    record graph-pass {
        /// The name other passes read this one by. Empty names it `pass<index>`.
        name: string,
        /// How the pass runs.
        stage: pass-stage,
        /// What the pass reads, in binding order; the first is also bound as
        /// `input_tex`. Empty reads the pass before it, or the source frame
        /// for the first pass.
        inputs: list<pass-input>,
        /// The last pass writes the effect's frame and uses `same`.
        output: output-size,
        /// The pass's WGSL source.
        wgsl: string,
    }

    /// What an effect graph states about its frame beyond its spec.
    record effect-traits {
        /// Pixels drawn beyond the layer's left, top, right, and bottom edges.
        bounds: tuple<f32, f32, f32, f32>,
        /// The effect samples its source outside `0.0..=1.0`.
        reads-outside: bool,
        /// The frame changes with time when the parameters do not. A pass of
        /// an effect that is not reads `aria.time` as zero.
        time-dependent: bool,
    }

    /// Flattened `f32` parameter value passed to `cpu-effect-process`.
    type effect-param = f32;

    /// One premultiplied RGBA16F video frame passed to and returned from
    /// `cpu-effect-process`: `width * height * 4` IEEE-754 binary16 bit
    /// patterns (`[R, G, B, A]` per pixel), top row first, with no row padding.
    record video-frame {
        /// Width in pixels.
        width: u32,
        /// Height in pixels.
        height: u32,
        /// Seconds since the clip's first frame, or 0 when the effect or clip type is not time
        /// dependent. An effect from `register-cpu-effect` is not.
        time: f32,
        /// `width * height * 4` binary16 bit patterns.
        pixels: list<u16>,
    }

    /// A label color: a clip type's timeline tint and a marker's color.
    enum marker-color {
        /// The Teal label.
        teal,
        /// The Blue label.
        blue,
        /// The Purple label.
        purple,
        /// The Magenta label.
        pink,
        /// The Rose label.
        red,
        /// The Mango label.
        orange,
        /// The Yellow label.
        yellow,
        /// The Green label.
        green,
    }

    /// Generator-backed clip type registration metadata.
    record clip-type-spec {
        /// Namespaced id with at least one `.`: at most 128 bytes, no space or control
        /// character, not already in the catalog.
        id: string,
        /// The name in the Generators tab, the palette, Effect Controls, and on the clip: 1 to
        /// 64 bytes.
        label: string,
        /// Id of the generator that draws the type. Not empty.
        generator: string,
        /// The timeline label color.
        colour: marker-color,
        /// SVG source of the icon drawn before the clip's name, or none.
        icon-svg: option<string>,
        /// Names of the generator's `vec2` parameters drawn as Viewer handles: at most 8, each
        /// once.
        handles: list<string>,
    }

    /// The fields each clip of a type that draws itself stores: effect
    /// parameters of any kind, saved with the clip, keyframed where the kind
    /// is, and drawn as the clip's rows in the inspector and on the timeline.
    record clip-type-schema {
        /// The fields, in row order. A handle names a `vec2` field.
        fields: list<effect-param-spec>,
        /// Collapsible groups that fields name in `group`.
        groups: list<effect-group-spec>,
        /// The picture changes with time when the fields do not. A type that
        /// does not is drawn at time 0.
        time-dependent: bool,
    }

    /// What draws a clip type that declares its fields.
    variant clip-type-render {
        /// `cpu-effect-process`, called with the type's id on a transparent
        /// frame of the clip's size and the field values.
        cpu,
        /// WGSL passes reading the fields as `aria.params`.
        passes(list<graph-pass>),
    }

    /// Property driver language registration metadata.
    record driver-language-spec {
        /// ASCII letters, digits, `.`, `-` and `_`. A second registration in one host is
        /// refused.
        id: string,
        /// The language's display name.
        name: string,
    }

    /// Property value passed to and returned from `driver-evaluate`.
    variant param-value {
        /// One value.
        scalar(f32),
        /// `(x, y)`.
        vec2(tuple<f32, f32>),
        /// `(x, y, z)`.
        vec3(tuple<f32, f32, f32>),
        /// RGBA8 `(r, g, b, a)`.
        color(tuple<u8, u8, u8, u8>),
        /// `(x, y, width, height)`.
        rect(tuple<f32, f32, f32, f32>),
    }

    /// Scope variables passed to `driver-evaluate`.
    record driver-vars {
        /// Sequence seconds being evaluated.
        time: f64,
        /// Seconds since the clip's first frame.
        clip-time: f64,
        /// Sequence frames per second.
        frame-rate: f64,
        /// Sequence length in seconds.
        duration: f64,
        /// Canvas width in pixels.
        canvas-width: u32,
        /// Canvas height in pixels.
        canvas-height: u32,
        /// The property's keyframed value at `time`.
        value: param-value,
        /// A number fixed per clip and property.
        seed: u64,
    }

    /// Keyboard focus target for a registered workspace.
    enum workspace-focus {
        /// The Project panel.
        media,
        /// The Viewer.
        preview,
        /// The Timeline.
        timeline,
        /// Effect Controls.
        inspector,
        /// The assistant.
        assistant,
        /// The mixer.
        mixer,
    }

    /// Pane arrangement restored when a workspace is applied.
    record workspace-panes {
        /// Sidebar width in pixels, above 0 and at most 16384. None keeps the Editing width.
        sidebar-width: option<f32>,
        /// Collapses the sidebar. None shows it.
        sidebar-collapsed: option<bool>,
        /// Inspector width in pixels, above 0 and at most 16384. None keeps the Editing width.
        inspector-width: option<f32>,
        /// Collapses the inspector. None shows it.
        inspector-collapsed: option<bool>,
        /// Timeline height in pixels, above 0 and at most 16384. None keeps the Editing height.
        timeline-height: option<f32>,
        /// Opens the scope strip. None leaves it closed.
        scopes: option<bool>,
        /// The pane that takes the keyboard. None selects the Timeline.
        focus: option<workspace-focus>,
    }

    /// Workspace registration metadata.
    record workspace-spec {
        /// Unique within the plugin: 1 to 64 ASCII letters, digits, `-`, `_` and `.`, not
        /// starting with `.`.
        id: string,
        /// The Window menu row and the Settings row: one line of at most 64 bytes.
        name: string,
        /// The arrangement applied.
        panes: workspace-panes,
    }

    /// What target an audio analyzer operates on.
    enum analyzer-scope {
        /// The selected clip's sound, offered in Clip > Analyze.
        clip,
        /// The whole sequence mix, offered in Sequence > Analyze.
        sequence,
        /// The sequence mix from In to Out, or the whole sequence when no range is marked,
        /// offered in Sequence > Analyze.
        in-out,
    }

    /// Audio analyzer registration metadata.
    record analyzer-spec {
        /// Namespaced id with at least one `.`: ASCII letters, digits, `.`, `_` and `-`.
        id: string,
        /// The menu row, palette row, job title, and undo step name. Not blank.
        label: string,
        /// An optional grouping label.
        category: option<string>,
        /// What the analyzer reads and which menu lists it.
        scope: analyzer-scope,
    }

    /// Exact timestamp `value / (rate-num / rate-den)` seconds.
    record rational-time {
        /// Tick count.
        value: s64,
        /// Tick rate numerator.
        rate-num: s32,
        /// Tick rate denominator.
        rate-den: s32,
    }

    /// Half-open time interval `[start, start + duration)`.
    record time-range {
        /// The first tick.
        start: rational-time,
        /// The length, at the rate of `start`.
        duration: rational-time,
    }

    /// Summary of a timeline clip returned by project queries.
    record clip-ref {
        /// The clip id.
        id: u64,
        /// Id of the track holding the clip.
        track: u64,
        /// The clip's first tick on the timeline.
        start: rational-time,
        /// The tick after the clip's last frame.
        end: rational-time,
        /// `media`, `sequence`, `multicam`, the generator id of a generated clip, or the clip
        /// type id of a typed clip.
        kind: string,
        /// The clip's title. A typed clip with no name of its own reads the type's name.
        name: string,
    }

    /// Sequence In and Out points from the editor view.
    record in-out-marks {
        /// The In point, or none when unset.
        mark-in: option<rational-time>,
        /// The Out point, or none when unset.
        mark-out: option<rational-time>,
    }

    /// Category of a ruler marker.
    enum marker-kind {
        /// A note.
        comment,
        /// A chapter point.
        chapter,
        /// A segment, such as a range an analyzer writes.
        segmentation,
    }

    /// Ruler marker on a sequence timeline.
    record marker {
        /// The marker id.
        id: u64,
        /// Position on the sequence timeline.
        tick: rational-time,
        /// Span of a range marker, or 0 ticks for a point marker.
        duration: rational-time,
        /// The marker name.
        name: string,
        /// The marker color.
        color: marker-color,
        /// Comment text, empty when none.
        comment: string,
        /// The marker category.
        kind: marker-kind,
    }

    /// Emit a log line at `level`. The line is kept in the plugin's log in Settings > Plugins.
    import log: func(level: log-level, text: string);

    /// Read a key from the package's storage directory, `<data_root>/plugin-data/<id>`.
    import storage-get: func(key: string) -> result<option<list<u8>>, string>;

    /// Write `value` under `key` in the package's storage directory.
    import storage-set: func(key: string, value: list<u8>) -> result<_, string>;

    /// Delete `key` from the package's storage directory.
    import storage-delete: func(key: string) -> result<_, string>;

    /// List every key in the package's storage directory in sorted order.
    import storage-keys: func() -> result<list<string>, string>;

    /// Read a setting value as JSON text, or `none` if unset.
    import setting-get: func(key: string) -> result<option<string>, string>;

    /// Register a palette command during `mount`.
    import register-command: func(id: string, title: string) -> result<_, string>;

    /// Subscribe to an event kind during `mount`. The kinds, payloads, and
    /// replies are listed in [Events](events.md#external-plugins); the event
    /// type name (`CommandApplied`) is accepted for its kind (`command-applied`).
    /// `resolve-dropped:<n>` sets the handler priority to the `s32` `n`; the
    /// default is 0, and no other kind takes a priority.
    import subscribe: func(event-kind: string) -> result<_, string>;

    /// Register a timeline importer during `mount`.
    import register-importer: func(spec: importer-spec) -> result<_, string>;

    /// Register a timeline exporter during `mount`.
    import register-exporter: func(spec: exporter-spec) -> result<_, string>;

    /// Register a media format encoder during `mount`.
    import register-encoder: func(spec: encoder-spec) -> result<_, string>;

    /// Register an audio effect during `mount`.
    import register-audio-effect: func(spec: audio-effect-spec) -> result<_, string>;

    /// Register a docked declarative UI panel during `mount`.
    import register-panel: func(spec: panel-spec) -> result<_, string>;

    /// Queue a rebuild of a panel owned by this plugin.
    import refresh-panel: func(id: string) -> result<_, string>;

    /// Register a viewer overlay during `mount`.
    import register-viewer-overlay: func(spec: overlay-spec) -> result<_, string>;

    /// Queue a scene rebuild of a viewer overlay owned by this plugin.
    import refresh-viewer-overlay: func(id: string) -> result<_, string>;

    /// Serialize the open project as serde JSON (`aria_models::Project`).
    /// Requires permission `project = "read"` or `"read-write"`.
    import project-snapshot: func() -> result<string, string>;

    /// Serialize the editor view (selection, playhead, in/out) as JSON.
    /// Requires permission `project = "read"` or `"read-write"`.
    import editor-view: func() -> result<string, string>;

    /// Look up clip `id` across the project's sequences.
    /// Requires permission `project = "read"` or `"read-write"`.
    import clip: func(id: u64) -> result<option<clip-ref>, string>;

    /// Clips on `sequence` (`none` for the open sequence) overlapping the half-open `range`,
    /// in track order then timeline start order.
    /// Requires permission `project = "read"` or `"read-write"`.
    import clips-in-range: func(sequence: option<u64>, range: time-range) -> result<list<clip-ref>, string>;

    /// Clips on `sequence` (`none` for the open sequence) covering `tick`,
    /// in track order then timeline start order.
    /// Requires permission `project = "read"` or `"read-write"`.
    import clips-at: func(sequence: option<u64>, tick: rational-time) -> result<list<clip-ref>, string>;

    /// Selected clips from `EditorView` resolved to `clip-ref`, dropping deleted ids.
    /// Requires permission `project = "read"` or `"read-write"`.
    import selected-clips: func() -> result<list<clip-ref>, string>;

    /// Ruler markers on `sequence` (`none` for the open sequence) overlapping the half-open `range`,
    /// in timeline order.
    /// Requires permission `project = "read"` or `"read-write"`.
    import markers-in-range: func(sequence: option<u64>, range: time-range) -> result<list<marker>, string>;

    /// Sequence In and Out points from `EditorView`.
    /// Requires permission `project = "read"` or `"read-write"`.
    import in-out: func() -> result<in-out-marks, string>;

    /// Apply a command list (`Vec<aria_commands::Command>` JSON) as one undo step.
    /// Requires permission `project = "read-write"`.
    import project-transact: func(label: string, commands-json: string) -> result<string, string>;

    /// Undo the latest step on the project host.
    /// Requires permission `project = "read-write"`.
    import project-undo: func() -> result<bool, string>;

    /// Read bytes from a permitted filesystem path or active import target.
    import fs-read: func(path: string) -> result<list<u8>, string>;

    /// Write bytes to a permitted filesystem path or active export target.
    import fs-write: func(path: string, bytes: list<u8>) -> result<_, string>;

    /// Start a background job on the jobs board, labeled with the plugin's
    /// name and `label`. The host calls `job-step` with the returned id until
    /// a step is done, Cancel is pressed, or a step fails, then `job-end`.
    import start-job: func(label: string) -> result<u64, string>;

    /// Register a media decoder during `mount`.
    import register-decoder: func(spec: decoder-spec) -> result<_, string>;

    /// Read up to `len` bytes from byte `offset` of a permitted path or the
    /// file being decoded: fewer only at end of file. At most 64 MiB per call.
    import fs-read-at: func(path: string, offset: u64, len: u32) -> result<list<u8>, string>;

    /// Length in bytes of a permitted path or the file being decoded.
    import fs-len: func(path: string) -> result<u64, string>;

    /// Offer the assistant an AI tool during `mount`. `ai-tool-call` runs it.
    import register-ai-tool: func(spec: ai-tool-spec) -> result<_, string>;

    /// Add a scope to the scope strip during `mount`. `scope-measure` draws it.
    import register-scope: func(spec: scope-spec) -> result<_, string>;

    /// Set the category of an audio or video effect registered by this plugin.
    import set-effect-category: func(id: string, category: string) -> result<_, string>;

    /// Register a WGSL visual effect during `mount`.
    import register-effect: func(spec: effect-spec, passes: list<string>) -> result<_, string>;

    /// Register a CPU visual effect or generator during `mount`. `cpu-effect-process` renders it.
    import register-cpu-effect: func(spec: effect-spec) -> result<_, string>;

    /// Register a WGSL transition during `mount`.
    import register-transition: func(spec: transition-spec, wgsl: string) -> result<_, string>;

    /// Register a WGSL generator during `mount`.
    import register-generator: func(spec: effect-spec, passes: list<string>) -> result<_, string>;

    /// Register a WGSL effect graph during `mount`: an effect, or a generator
    /// when `spec.generator` is set.
    import register-effect-graph: func(spec: effect-spec, traits: effect-traits, passes: list<graph-pass>) -> result<_, string>;

    /// Register straight-alpha RGBA8 `pixels`, `width * height * 4` bytes
    /// with the top row first, as the plugin texture `id` during `mount`.
    import register-texture: func(id: string, width: u32, height: u32, pixels: list<u8>) -> result<_, string>;

    /// Register a generator-backed clip type during `mount`.
    import register-clip-type: func(spec: clip-type-spec) -> result<_, string>;

    /// Register during `mount` a clip type whose clips store `schema.fields`
    /// and that `render` draws. The host registers a generator under the
    /// type's id; `spec.generator` is empty or that id.
    import define-clip-type: func(spec: clip-type-spec, schema: clip-type-schema, render: clip-type-render) -> result<_, string>;

    /// Register a property driver language during `mount`. `driver-evaluate` evaluates it.
    import register-driver-language: func(spec: driver-language-spec) -> result<_, string>;

    /// Register an animation and effect preset JSON during `mount`.
    import register-preset: func(preset-json: string) -> result<_, string>;

    /// Register a theme TOML under `id` during `mount`.
    import register-theme: func(id: string, toml: string) -> result<_, string>;

    /// Register a workspace arrangement during `mount`.
    import register-workspace: func(spec: workspace-spec) -> result<_, string>;

    /// Register an audio analyzer during `mount`.
    import register-analyzer: func(spec: analyzer-spec) -> result<_, string>;

    /// Mount the plugin. Registration calls are permitted only during `mount`.
    export mount: func() -> result<_, string>;

    /// Unmount the plugin before unload or reload.
    export unmount: func() -> result<_, string>;

    /// Run a command previously registered by this plugin.
    export command-run: func(id: string, args-json: string) -> result<_, string>;

    /// Handle an event of a subscribed kind. `kind` is the kebab-case kind,
    /// whichever spelling subscribed; `event-json` is the event as a JSON
    /// object. The reply refuses or rewrites a `command-proposed` command and
    /// claims a `resolve-dropped` item; every other kind ignores it.
    export event: func(kind: string, event-json: string) -> result<option<string>, string>;

    /// Import a timeline file at `path` using `importer-id`.
    export %import: func(importer-id: string, path: string) -> result<import-result, string>;

    /// Export `project-json` to `path` using `exporter-id`.
    export %export: func(exporter-id: string, project-json: string, path: string) -> result<report, string>;

    /// Create an audio processor instance for `effect-id` at `sample-rate`.
    export audio-create: func(effect-id: string, sample-rate: u32) -> result<instance, string>;

    /// Process one stereo planar audio block on `instance`.
    export audio-process: func(instance: instance, params: list<audio-param>, block: audio-block) -> result<stereo-buffers, string>;

    /// Reset internal DSP state on `instance` after a transport seek.
    export audio-reset: func(instance: instance) -> result<_, string>;

    /// Drop an audio processor instance created by `audio-create`.
    export audio-drop: func(instance: instance) -> result<_, string>;

    /// Build the flattened `ui-node` tree (`root = index 0`) for panel `id`.
    export panel-view: func(id: string) -> list<ui-node>;

    /// Handle a user control interaction on panel `id`.
    export panel-event: func(id: string, event: panel-event) -> result<_, string>;

    /// Build the shape list for viewer overlay `id`.
    export overlay-scene: func(id: string) -> list<overlay-shape>;

    /// Handle a user handle drag interaction on viewer overlay `id`.
    export overlay-event: func(id: string, event: overlay-event) -> result<_, string>;

    /// Open an encoder session for `encoder-id` writing `config` to `path`.
    export encoder-open: func(encoder-id: string, path: string, config: encoder-config) -> result<instance, string>;

    /// Push one straight-alpha RGBA8 video frame to an open encoder session.
    export encoder-push-frame: func(instance: instance, frame: encoder-frame) -> result<_, string>;

    /// Push one interleaved `f32` audio block to an open encoder session.
    export encoder-push-audio: func(instance: instance, audio: encoder-audio) -> result<_, string>;

    /// Finalize an open encoder session and flush its output via `fs-write`.
    export encoder-finish: func(instance: instance) -> result<_, string>;

    /// Drop an open encoder session without finalizing it.
    export encoder-drop: func(instance: instance) -> result<_, string>;

    /// Run one step of job `job`, started by `start-job`.
    export job-step: func(job: u64) -> result<job-step, string>;

    /// Job `job` ended: done, failed, or cancelled when `cancelled` is true.
    export job-end: func(job: u64, cancelled: bool);

    /// Describe `path` with decoder `decoder-id` without decoding it.
    export decoder-probe: func(decoder-id: string, path: string) -> result<media-probe, decode-error>;

    /// Open the video stream of `path` with decoder `decoder-id`.
    export decoder-open-video: func(decoder-id: string, path: string) -> result<opened-video, decode-error>;

    /// Seek video stream `instance` to the sync frame at or before `pts`, in time-base ticks.
    export decoder-seek: func(instance: instance, pts: s64) -> result<_, string>;

    /// The next frame of video stream `instance`, or none at end of stream.
    export decoder-next-frame: func(instance: instance) -> result<option<decoded-frame>, string>;

    /// Open the audio of `path` with decoder `decoder-id`, resampled to `sample-rate` and `channels`.
    export decoder-open-audio: func(decoder-id: string, path: string, sample-rate: u32, channels: u16) -> result<instance, decode-error>;

    /// Up to `max-samples` interleaved samples of audio stream `instance`: whole frames,
    /// fewer only at end of stream.
    export decoder-read-audio: func(instance: instance, max-samples: u32) -> result<list<f32>, string>;

    /// Position the next read of audio stream `instance` at sample frame `frame`.
    export decoder-seek-audio: func(instance: instance, frame: s64) -> result<_, string>;

    /// Drop the video or audio stream `instance`.
    export decoder-close: func(instance: instance);

    /// Run the AI tool registered as `name` with `arguments-json`, an object
    /// matching its schema, on the assistant's turn thread.
    export ai-tool-call: func(name: string, arguments-json: string) -> result<ai-tool-output, string>;

    /// Measure `frame` with the scope registered as `id`, on the preview
    /// worker's thread while the scope strip is open.
    export scope-measure: func(id: string, frame: scope-frame) -> result<scope-drawing, string>;

    /// Render one premultiplied RGBA16F video frame for a CPU effect or generator registered as `id`.
    export cpu-effect-process: func(id: string, params: list<effect-param>, frame: video-frame) -> result<video-frame, string>;

    /// Evaluate driver expression `expr` for the driver language registered as `id`.
    export driver-evaluate: func(id: string, expr: string, vars: driver-vars) -> result<param-value, string>;

    /// Open an audio analyzer session for `id` at `sample-rate` Hz and `channels` channels.
    export analyzer-open: func(id: string, sample-rate: u32, channels: u16) -> result<instance, string>;

    /// Feed interleaved `f32` audio samples (`frames * channels`) into analyzer `instance`.
    export analyzer-push: func(instance: instance, samples: list<f32>) -> result<_, string>;

    /// Finish analyzer `instance` and return its `AnalyzerResult` JSON.
    export analyzer-finish: func(instance: instance) -> result<string, string>;

    /// Drop analyzer `instance` without finishing.
    export analyzer-drop: func(instance: instance);
}
