/target
/dist
# aria-py is excluded from the workspace, so it gets its own target dir,
# development virtualenv, and local wheel output.
/crates/aria-py/target/
/crates/aria-py/.venv/
/crates/aria-py/dist/
/crates/aria-py/uv.lock
__pycache__/
# Demo outputs (aria-cli, aria-render's export_demo example).
/aria-demo.png
/aria-demo.mp4
# Xcode / Swift Package Manager user state and build output.
xcuserdata/
.build/
# Prebuilt Rust FFI bundle for the Swift package (158MB of static libs);
# rebuild with scripts/build-ios-xcframework.sh.
apps/aria-ios-macos/AriaMobile/AriaMobileFFI.xcframework/
apps/aria-android/app/src/main/jniLibs/
# IDE metadata (Android Studio / IntelliJ).
.idea/
local-assets/
.env
.DS_Store
frames/
proxy/
.aria/
run.sh
venv/
crates/aria-py/examples/trailer.mp4
trailer.aria
# Agent task scaffolding (local only; do not commit).
AGENT_TASK.md
AGENT-REPORT.md
.cursor/plans/
.cursor/skills/
AGENT-PROVIDERS.md
.internal/
# Review-only audit backlog (never committed).
/BACKLOG.md
# Coverage and fuzzing output.
*.profraw
*.profdata
lcov.info
/fuzz/artifacts/
/fuzz/corpus/
# Inno Setup's default output when aria.iss runs without the packaging script.
/packaging/windows/Output/
# Where every test writes its temporary files: `.cargo/config.toml` points
# TMPDIR here, so nothing this workspace runs lands in the system temp dir. The
# directory itself is tracked (tempfile refuses a root that does not exist);
# everything inside it is not.
/scratch/*
!/scratch/.gitkeep
# Linked git worktrees of this repository.
/worktrees/
